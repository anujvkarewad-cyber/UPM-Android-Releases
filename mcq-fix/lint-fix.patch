From cc73c51572b34dd8b83cafd3449c56ed1020405a Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Tue, 18 Aug 2026 08:38:29 +0000
Subject: [PATCH] Fix CI lint: stable chapters reference for useMemo hooks

CI=true treats react-hooks/exhaustive-deps warnings as errors, which
broke the Render frontend build. chapters now derives from a stable
useMemo so the subjects memo dependency cannot change every render.
---
 frontend/src/pages/ai-content/ChapterCoverage.jsx | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/frontend/src/pages/ai-content/ChapterCoverage.jsx b/frontend/src/pages/ai-content/ChapterCoverage.jsx
index d4682e0..abf893b 100644
--- a/frontend/src/pages/ai-content/ChapterCoverage.jsx
+++ b/frontend/src/pages/ai-content/ChapterCoverage.jsx
@@ -161,7 +161,10 @@ export default function ChapterCoverage() {
   const { data, isLoading } = useChapters();
   const [openChapter, setOpenChapter] = useState(null);
 
-  const chapters = data?.items || [];
+  const items = data?.items;
+  // Stable reference so the derived hooks below don't re-run every render
+  // (react-hooks/exhaustive-deps) and CI lint stays green.
+  const chapters = useMemo(() => items || [], [items]);
 
   const bulkChapter = useBulkApproveChapter();
   const bulkSubject = useBulkApproveSubject();
-- 
